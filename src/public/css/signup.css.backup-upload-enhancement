/* Enhanced Signup Page - Modern Design with Custom Colors */
.signup-container {
  position: relative;
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #ccdbfd 0%, #b6ccfe 50%, #a8c8ff 100%);
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  padding: 2rem 1rem;
}

/* Page Header Styles */
.page-header {
  width: 95%;
  max-width: 800px;
  margin-bottom: 3rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 2rem;
}

.header-content {
  display: flex;
  align-items: center;
  gap: 2rem;
}

.header-icon {
  width: 100px;
  height: 100px;
  background: linear-gradient(135deg, #2c3e50, #34495e);
  border-radius: 25px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.8rem;
  color: #fff;
  box-shadow: 0 12px 30px rgba(44, 62, 80, 0.3);
}

.header-text {
  color: #2c3e50;
}

.page-title {
  font-size: 3.2rem;
  font-weight: 800;
  margin: 0;
  text-shadow: 0 0 20px rgba(44, 62, 80, 0.3);
}

.page-subtitle {
  font-size: 1.4rem;
  color: #34495e;
  margin: 0.8rem 0 0 0;
  opacity: 0.9;
  font-weight: 500;
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  padding: 1rem 2rem;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 2px solid rgba(44, 62, 80, 0.2);
  border-radius: 15px;
  color: #2c3e50;
  text-decoration: none;
  font-size: 1.1rem;
  font-weight: 600;
  transition: all 0.3s ease;
  box-shadow: 0 8px 25px rgba(44, 62, 80, 0.1);
}

.back-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 15px 35px rgba(44, 62, 80, 0.2);
  border-color: rgba(44, 62, 80, 0.4);
  color: #2c3e50;
}

/* Main Form Container */
.signup-frame {
  width: 95%;
  max-width: 800px;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 2px solid rgba(44, 62, 80, 0.2);
  border-radius: 25px;
  padding: 3rem;
  box-shadow: 0 15px 40px rgba(44, 62, 80, 0.15);
  animation: fadeInUp 0.6s ease;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Navigation Links */
.signup-top {
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 2px solid rgba(44, 62, 80, 0.1);
}

.nav-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
}

.nav-text {
  font-size: 1.2rem;
  color: #34495e;
  font-weight: 500;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.8rem 1.5rem;
  background: rgba(44, 62, 80, 0.1);
  border-radius: 12px;
  color: #2c3e50;
  text-decoration: none;
  font-size: 1.1rem;
  font-weight: 600;
  transition: all 0.3s ease;
}

.nav-link:hover {
  background: rgba(44, 62, 80, 0.2);
  transform: translateY(-2px);
  color: #2c3e50;
}

/* Form Sections */
.form-section {
  margin-bottom: 3rem;
}

.section-title {
  color: #2c3e50;
  font-size: 1.8rem;
  font-weight: 700;
  margin: 0 0 2rem 0;
  display: flex;
  align-items: center;
  gap: 0.8rem;
}

.section-title i {
  color: #34495e;
  font-size: 1.5rem;
}

/* Form Input Frame */
.sign-input-frame {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  margin-bottom: 2rem;
}

.sign-up-frame {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.form-label {
  color: #2c3e50;
  font-size: 1.2rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.form-label i {
  color: #34495e;
  font-size: 1rem;
}

.form-input {
  padding: 1.2rem 1.5rem;
  border: 2px solid rgba(44, 62, 80, 0.2);
  border-radius: 15px;
  font-size: 1.1rem;
  color: #2c3e50;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  transition: all 0.3s ease;
  font-family: 'Segoe UI', sans-serif;
}

.form-input:focus {
  outline: none;
  border-color: rgba(44, 62, 80, 0.5);
  box-shadow: 0 0 0 3px rgba(44, 62, 80, 0.1);
  background: rgba(255, 255, 255, 0.95);
}

.form-input::placeholder {
  color: #7f8c8d;
  font-weight: 400;
}

/* Image Upload Section */
.signup-input-frame {
  margin-top: 2rem;
}

.media-frame {
  display: flex;
  gap: 3rem;
  align-items: flex-start;
}

.image-preview-container {
  position: relative;
  width: 200px;
  height: 200px;
  border-radius: 20px;
  overflow: hidden;
  border: 3px solid rgba(44, 62, 80, 0.2);
  background: rgba(255, 255, 255, 0.8);
  cursor: pointer;
  transition: all 0.3s ease;
}

.image-preview-container:hover {
  border-color: rgba(44, 62, 80, 0.4);
  transform: scale(1.02);
}

.upload-img-frame {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: all 0.3s ease;
}

.image-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(44, 62, 80, 0.8);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 1rem;
  font-weight: 600;
  opacity: 0;
  transition: all 0.3s ease;
}

.image-preview-container:hover .image-overlay {
  opacity: 1;
}

.image-overlay i {
  font-size: 2rem;
  margin-bottom: 0.5rem;
}

.upload-container {
  flex: 1;
}

.upload-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.media-text {
  font-size: 1.4rem;
  font-weight: 700;
  color: #2c3e50;
}

.file-requirements {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: #34495e;
  font-size: 0.9rem;
  font-weight: 500;
}

.file-box {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 2rem;
}

.upload-name {
  flex: 1;
  padding: 1rem 1.5rem;
  border: 2px solid rgba(44, 62, 80, 0.2);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.8);
  color: #7f8c8d;
  font-size: 1rem;
  font-weight: 500;
}

.file-input-label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem 2rem;
  background: rgba(44, 62, 80, 0.1);
  border-radius: 12px;
  color: #2c3e50;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

.file-input-label:hover {
  background: rgba(44, 62, 80, 0.2);
  transform: translateY(-2px);
}

.upload-hidden {
  display: none;
}

.thumbnail-desc {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.desc-item {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  color: #34495e;
  font-size: 1rem;
  font-weight: 500;
}

.desc-item i {
  color: #27ae60;
  font-size: 0.9rem;
}

/* Submit Section */
.submit-section {
  text-align: center;
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 2px solid rgba(44, 62, 80, 0.1);
}

.signup-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.8rem;
  width: 100%;
  max-width: 300px;
  margin: 0 auto 2rem auto;
  padding: 1.5rem 3rem;
  background: linear-gradient(135deg, #2c3e50, #34495e);
  border: none;
  border-radius: 15px;
  color: #fff;
  font-size: 1.3rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 8px 25px rgba(44, 62, 80, 0.3);
}

.signup-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 15px 35px rgba(44, 62, 80, 0.4);
  background: linear-gradient(135deg, #34495e, #2c3e50);
}

.signup-btn:active {
  transform: translateY(-1px);
}

.terms-notice {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.8rem;
  color: #7f8c8d;
  font-size: 0.9rem;
  font-weight: 500;
  max-width: 500px;
  margin: 0 auto;
}

.terms-notice i {
  color: #27ae60;
  font-size: 1rem;
}

/* Responsive Design */
@media (max-width: 768px) {
  .page-header {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  
  .header-content {
    flex-direction: column;
    text-align: center;
  }
  
  .sign-input-frame {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .media-frame {
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }
  
  .image-preview-container {
    width: 150px;
    height: 150px;
  }
  
  .upload-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  
  .file-box {
    flex-direction: column;
    align-items: stretch;
  }
}

@media (max-width: 480px) {
  .signup-container {
    padding: 1rem 0.5rem;
  }
  
  .signup-frame {
    padding: 2rem 1.5rem;
  }
  
  .page-title {
    font-size: 2.4rem;
  }
  
  .header-icon {
    width: 80px;
    height: 80px;
    font-size: 2.2rem;
  }
  
  .section-title {
    font-size: 1.5rem;
  }
  
  .form-input {
    padding: 1rem 1.2rem;
    font-size: 1rem;
  }
  
  .signup-btn {
    padding: 1.2rem 2rem;
    font-size: 1.1rem;
  }
}
