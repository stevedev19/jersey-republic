<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/signup.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>

<body>
  <div class="signup-container">
    <!-- Enhanced Header Section -->
    <div class="page-header">
      <div class="header-content">
        <div class="header-icon">
          <i class="fas fa-user-plus"></i>
        </div>
        <div class="header-text">
          <h1 class="page-title">Create Account</h1>
          <p class="page-subtitle">Join Jersey Republic Management System</p>
        </div>
      </div>
      <div class="back-link">
        <a href="/admin" class="back-btn">
          <i class="fas fa-arrow-left"></i>
          Back to Home
        </a>
      </div>
    </div>

    <form onsubmit="return validateSignForm()"
     action="/admin/signup" 
     method="POST" 
     enctype="multipart/form-data">
      
      <div class="signup-frame">
        <!-- Navigation Links -->
        <div class="signup-top">
          <div class="nav-links">
            <span class="nav-text">Already have an account?</span>
            <a href="/admin/login" class="nav-link">
              <i class="fas fa-sign-in-alt"></i>
              Login Here
            </a>
          </div>
        </div>

        <!-- Form Fields -->
        <div class="form-section">
          <h3 class="section-title">
            <i class="fas fa-user"></i>
            Account Information
          </h3>
          
          <div class="sign-input-frame">
            <div class="sign-up-frame">
              <label class="form-label">
                <i class="fas fa-store"></i>
                Restaurant Name *
              </label>
              <input
                type="text"
                name="memberNick"
                class="member-nick form-input"
                placeholder="Enter your restaurant name"
                value=""
                required
              />
            </div>
            <div class="sign-up-frame">
              <label class="form-label">
                <i class="fas fa-phone"></i>
                Phone Number *
              </label>
              <input
                type="text"
                name="memberPhone"
                class="member-phone form-input"
                placeholder="Enter your phone number"
                value=""
                required
              />
            </div>
          </div>

          <div class="sign-input-frame">
            <div class="sign-up-frame">
              <label class="form-label">
                <i class="fas fa-lock"></i>
                Password *
              </label>
              <input
                type="password"
                name="memberPassword"
                class="member-password form-input"
                placeholder="Create a strong password"
                value=""
                required
              />
            </div>
            <div class="sign-up-frame">
              <label class="form-label">
                <i class="fas fa-lock"></i>
                Confirm Password *
              </label>
              <input
                type="password"
                name="confirmPassword"
                class="confirm-password form-input"
                placeholder="Confirm your password"
                value=""
                required
              />
            </div>
          </div>
        </div>

        <!-- Image Upload Section -->
        <div class="form-section">
          <h3 class="section-title">
            <i class="fas fa-image"></i>
            Restaurant Image
          </h3>
          
          <div class="signup-input-frame">
            <div class="media-frame">
              <div class="image-preview-container">
                <img class="upload-img-frame" src="/img/default.jpeg" id="imagePreview" />
                <div class="image-overlay">
                  <i class="fas fa-camera"></i>
                  <span>Click to upload</span>
                </div>
              </div>
              
              <div class="upload-container">
                <div class="upload-header">
                  <span class="media-text">Restaurant Image</span>
                  <div class="file-requirements">
                    <i class="fas fa-info-circle"></i>
                    <span>JPG, JPEG, or PNG only</span>
                  </div>
                </div>
                
                <div class="file-box preview-image">
                  <input
                    class="upload-name"
                    value="Choose image"
                    disabled="disabled"
                    id="fileName"
                  />
                  <label for="input-file" class="file-input-label">
                    <i class="fas fa-upload"></i>
                    Upload Image
                  </label>
                  <input
                    type="file"
                    id="input-file"
                    class="upload-hidden form-control-file member-image"
                    name="memberImage"
                    accept="image/jpeg,image/jpg,image/png"
                  />
                </div>
                
                <div class="thumbnail-desc">
                  <div class="desc-item">
                    <i class="fas fa-check-circle"></i>
                    <span>High quality image recommended</span>
                  </div>
                  <div class="desc-item">
                    <i class="fas fa-check-circle"></i>
                    <span>Maximum file size: 5MB</span>
                  </div>
                  <div class="desc-item">
                    <i class="fas fa-check-circle"></i>
                    <span>Supported formats: JPG, JPEG, PNG</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Hidden Field -->
        <input name="memberType" value="RESTAURANT" hidden />

        <!-- Submit Button -->
        <div class="submit-section">
          <button class="signup-btn btn" name="signup" type="submit">
            <i class="fas fa-user-plus"></i>
            Create Account
          </button>
          
          <div class="terms-notice">
            <i class="fas fa-shield-alt"></i>
            <span>By creating an account, you agree to our Terms of Service and Privacy Policy</span>
          </div>
        </div>
      </div>
    </form>
  </div>

  <script type="text/javascript" src="/js/signup.js"></script>
</body>

<%- include('includes/footer') %>
