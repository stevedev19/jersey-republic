<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />
<link rel="stylesheet" type="text/css" href="/css/utilities.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>

<body>
  <div class="home-container">
    <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item cursor-pointer">
          <a class="nav-link active" href="/admin">Home</a>
        </li>
        <% if(!member) { %>
        <li class="nav-item cursor-pointer">
          <a class="nav-link" href="/admin/signup">Signup</a>
        </li>
        <li class="nav-item cursor-pointer">
          <a class="nav-link" href="/admin/login">Login</a>
        </li>
        <% } else { %>
        <li class="nav-item cursor-pointer">
          <a class="nav-link" href="/admin/product/all">Jerseys</a>
        </li>
        <li class="nav-item cursor-pointer">
          <a class="nav-link" href="/admin/user/all">Users</a>
        </li>
        <li
          class="nav-item cursor-pointer"
          onclick="return confirm('Do you want to logout?')"
        >
          <a class="nav-link" href="/admin/logout">Logout</a>
        </li>
        <% } %>
      </ul>
    </div>

    <!-- Enhanced Header Section -->
    <div class="page-header">
      <div class="header-content">
        <div class="header-icon">
          <i class="fas fa-home"></i>
        </div>
        <div class="header-text">
          <h1 class="page-title">Admin Dashboard</h1>
          <p class="page-subtitle">Welcome to Jersey Republic Management System</p>
        </div>
      </div>
      <div class="live-clock-container">
        <div class="live-clock" id="liveClock">--:--:--</div>
        <div class="clock-label">Current Time</div>
      </div>
    </div>

    <!-- Photo Background Container -->
    <div class="photo-container photo-container-bg">
      <div class="photo-overlay"></div>
    </div>


    <% if(member) { %>
    <!-- System Overview Section - Only visible when admin is logged in -->
    <div class="dashboard-section">
      <div class="section-header">
        <h2 class="section-title">
          <i class="fas fa-chart-line"></i>
          System Overview
        </h2>
        <div class="refresh-indicator">
          <i class="fas fa-sync-alt"></i>
          <span>Auto-refresh</span>
        </div>
      </div>

      <div class="dashboard-cards">
        <div class="glass-card">
          <div class="card-icon">
            <i class="fas fa-users"></i>
          </div>
          <div class="card-content">
            <h3 class="card-title">Total Users</h3>
            <p class="card-value" id="totalUsers">0</p>
            <div class="card-trend">
              <i class="fas fa-arrow-up"></i>
              <span>+12% this month</span>
            </div>
          </div>
        </div>

        <div class="glass-card">
          <div class="card-icon">
            <i class="fas fa-user-check"></i>
          </div>
          <div class="card-content">
            <h3 class="card-title">Active Users</h3>
            <p class="card-value" id="activeLogins">0</p>
            <div class="card-trend">
              <i class="fas fa-arrow-up"></i>
              <span>+8% this week</span>
            </div>
          </div>
        </div>

        <div class="glass-card">
          <div class="card-icon">
            <i class="fas fa-clock"></i>
          </div>
          <div class="card-content">
            <h3 class="card-title">Last Activity</h3>
            <p class="card-value" id="lastActivity">--:--</p>
            <div class="card-trend">
              <i class="fas fa-circle"></i>
              <span>Live updates</span>
            </div>
          </div>
        </div>

        <div class="glass-card">
          <div class="card-icon">
            <i class="fas fa-tshirt"></i>
          </div>
          <div class="card-content">
            <h3 class="card-title">Total Jerseys</h3>
            <p class="card-value" id="totalJerseys">0</p>
            <div class="card-trend">
              <i class="fas fa-arrow-up"></i>
              <span>+5 new this week</span>
            </div>
          </div>
        </div>

        <div class="glass-card">
          <div class="card-icon">
            <i class="fas fa-dollar-sign"></i>
          </div>
          <div class="card-content">
            <h3 class="card-title">Total Revenue</h3>
            <p class="card-value" id="totalRevenue">$0</p>
            <div class="card-trend">
              <i class="fas fa-arrow-up"></i>
              <span>+15% this month</span>
            </div>
          </div>
        </div>

        <div class="glass-card">
          <div class="card-icon">
            <i class="fas fa-chart-pie"></i>
          </div>
          <div class="card-content">
            <h3 class="card-title">Orders Today</h3>
            <p class="card-value" id="ordersToday">0</p>
            <div class="card-trend">
              <i class="fas fa-arrow-up"></i>
              <span>+3 from yesterday</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Actions Section - Only visible when admin is logged in -->
    <div class="quick-actions-section">
      <div class="section-header">
        <h2 class="section-title">
          <i class="fas fa-bolt"></i>
          Quick Actions
        </h2>
      </div>
      
      <div class="action-buttons">
        <a href="/admin/product/all" class="action-btn">
          <div class="action-icon">
            <i class="fas fa-tshirt"></i>
          </div>
          <div class="action-content">
            <h4>Manage Jerseys</h4>
            <p>Add, edit, or remove products</p>
          </div>
        </a>

        <a href="/admin/user/all" class="action-btn">
          <div class="action-icon">
            <i class="fas fa-users"></i>
          </div>
          <div class="action-content">
            <h4>Manage Users</h4>
            <p>View and manage user accounts</p>
          </div>
        </a>
      </div>
    </div>

    <!-- Recent Activity Section - Only visible when admin is logged in -->
    <div class="recent-activity-section">
      <div class="section-header">
        <h2 class="section-title">
          <i class="fas fa-history"></i>
          Recent Activity
        </h2>
        <div class="section-actions">
          <button class="action-btn-small" onclick="clearAllActivity()" title="Clear All Activity">
            <i class="fas fa-trash-alt"></i>
            Clear All
          </button>
        </div>
      </div>
      
      <div class="activity-list" id="activityList">
        <div class="activity-item">
          <div class="activity-icon">
            <i class="fas fa-user-plus"></i>
          </div>
          <div class="activity-content">
            <h4>New user registered</h4>
            <p>John Doe joined the platform</p>
            <span class="activity-time">2 minutes ago</span>
          </div>
          <div class="activity-actions">
            <button class="delete-activity-btn" onclick="deleteActivity(this)" title="Delete Activity">
              <i class="fas fa-times"></i>
            </button>
          </div>
        </div>

        <div class="activity-item">
          <div class="activity-icon">
            <i class="fas fa-shopping-cart"></i>
          </div>
          <div class="activity-content">
            <h4>New order received</h4>
            <p>Arsenal Jersey - Size L</p>
            <span class="activity-time">15 minutes ago</span>
          </div>
          <div class="activity-actions">
            <button class="delete-activity-btn" onclick="deleteActivity(this)" title="Delete Activity">
              <i class="fas fa-times"></i>
            </button>
          </div>
        </div>

        <div class="activity-item">
          <div class="activity-icon">
            <i class="fas fa-tshirt"></i>
          </div>
          <div class="activity-content">
            <h4>Product updated</h4>
            <p>Real Madrid Jersey stock updated</p>
            <span class="activity-time">1 hour ago</span>
          </div>
          <div class="activity-actions">
            <button class="delete-activity-btn" onclick="deleteActivity(this)" title="Delete Activity">
              <i class="fas fa-times"></i>
            </button>
          </div>
        </div>

        <div class="activity-item">
          <div class="activity-icon">
            <i class="fas fa-star"></i>
          </div>
          <div class="activity-content">
            <h4>Review received</h4>
            <p>5-star rating for Manchester United Jersey</p>
            <span class="activity-time">2 hours ago</span>
          </div>
          <div class="activity-actions">
            <button class="delete-activity-btn" onclick="deleteActivity(this)" title="Delete Activity">
              <i class="fas fa-times"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
    <% } else { %>
    <!-- Welcome message for non-authenticated users -->
    <div class="welcome-section">
      <div class="welcome-content">
        <div class="welcome-icon">
          <i class="fas fa-shield-alt"></i>
        </div>
        <h2 class="welcome-title">Welcome to Jersey Republic Admin</h2>
        <p class="welcome-message">Please log in to access the admin dashboard and manage your jersey store.</p>
        <div class="welcome-actions">
          <a href="/admin/login" class="welcome-btn primary">
            <i class="fas fa-sign-in-alt"></i>
            Login
          </a>
          <a href="/admin/signup" class="welcome-btn secondary">
            <i class="fas fa-user-plus"></i>
            Sign Up
          </a>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <!-- Notification Container -->
  <div id="notificationContainer" class="notification-container"></div>

  <script type="text/javascript" src="/js/home.js"></script>
</body>

<%- include('includes/footer') %>
