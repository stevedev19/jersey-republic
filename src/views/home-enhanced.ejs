<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />
<link rel="stylesheet" type="text/css" href="/css/admin-glass.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<body>
  <div class="home-container">
    <!-- Glass-style Navbar -->
    <nav class="glass-navbar">
      <div class="navbar-content">
        <div class="navbar-logo">
          <h2 class="logo-text">Admin Panel</h2>
          <div class="live-clock" id="liveClock">--:--:--</div>
        </div>
        <div class="navbar-links">
          <a href="/admin" class="nav-link-glass">Home</a>
          <% if(!member) { %>
          <a href="#" class="nav-link-glass" onclick="openModal('signup')">Signup</a>
          <a href="#" class="nav-link-glass" onclick="openModal('login')">Login</a>
          <% } else { %>
          <a href="/admin/product/all" class="nav-link-glass">Jerseys</a>
          <a href="/admin/user/all" class="nav-link-glass">Users</a>
          <a href="/admin/logout" class="nav-link-glass" onclick="return confirm('Do you want to logout?')">Logout</a>
          <% } %>
        </div>
      </div>
    </nav>

    <!-- Floating Particles Animation -->
    <div class="animation-frame">
      <div class="particles-container">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
      </div>
    </div>

    <!-- Dashboard Cards -->
    <div class="dashboard-section">
      <div class="dashboard-cards">
        <div class="glass-card">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <div class="card-content">
            <h3 class="card-title">Total Users</h3>
            <p class="card-value" id="totalUsers">0</p>
          </div>
        </div>

        <div class="glass-card">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 12l2 2 4-4"></path>
              <path d="M21 12c-1 0-3-1-3-3s2-3 3-3 3 1 3 3-2 3-3 3"></path>
              <path d="M3 12c1 0 3-1 3-3s-2-3-3-3-3 1-3 3 2 3 3 3"></path>
            </svg>
          </div>
          <div class="card-content">
            <h3 class="card-title">Active Logins</h3>
            <p class="card-value" id="activeLogins">0</p>
          </div>
        </div>

        <div class="glass-card">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12,6 12,12 16,14"></polyline>
            </svg>
          </div>
          <div class="card-content">
            <h3 class="card-title">Last Activity</h3>
            <p class="card-value" id="lastActivity">--:--</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Signup Modal -->
  <div id="signupModal" class="modal-overlay">
    <div class="glass-modal">
      <div class="modal-header">
        <h2>Create Account</h2>
        <button class="close-btn" onclick="closeModal('signup')">&times;</button>
      </div>
      <form class="modal-form" id="signupForm">
        <div class="input-group">
          <input type="text" id="signupUsername" placeholder="Username" required>
          <div class="input-glow"></div>
        </div>
        <div class="input-group">
          <input type="tel" id="signupPhone" placeholder="Phone Number" required>
          <div class="input-glow"></div>
        </div>
        <div class="input-group">
          <input type="password" id="signupPassword" placeholder="Password" required>
          <div class="input-glow"></div>
        </div>
        <button type="submit" class="glow-button">Sign Up</button>
      </form>
    </div>
  </div>

  <!-- Login Modal -->
  <div id="loginModal" class="modal-overlay">
    <div class="glass-modal">
      <div class="modal-header">
        <h2>Login</h2>
        <button class="close-btn" onclick="closeModal('login')">&times;</button>
      </div>
      <form class="modal-form" id="loginForm">
        <div class="input-group">
          <input type="text" id="loginUsername" placeholder="Username" required>
          <div class="input-glow"></div>
        </div>
        <div class="input-group">
          <input type="password" id="loginPassword" placeholder="Password" required>
          <div class="input-glow"></div>
        </div>
        <button type="submit" class="glow-button">Login</button>
      </form>
    </div>
  </div>

  <script type="text/javascript" src="/js/home.js"></script>
  <script type="text/javascript" src="/js/admin-glass.js"></script>
</body>

<%- include('includes/footer') %>
