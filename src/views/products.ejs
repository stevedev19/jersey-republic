<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />
<link rel="stylesheet" type="text/css" href="/css/admin.css" />
<link rel="stylesheet" type="text/css" href="/css/utilities.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>

<body>
  <%
  function adminLeagueLabel(code) {
    if (!code) return '';
    const map = {
      PREMIER_LEAGUE: 'Premier League',
      LA_LIGA: 'La Liga',
      SERIE_A: 'Serie A',
      BUNDESLIGA: 'Bundesliga',
      LIGUE_1: 'Ligue 1',
      CHAMPIONS_LEAGUE: 'Champions League',
      NATIONAL_TEAMS: 'National Teams',
      UZBEKISTAN_LEAGUE: 'Uzbekistan League',
      RETRO: 'Retro',
      OTHER: 'Other',
      DISH: 'Dish',
      DRINK: 'Drink'
    };
    if (map[code]) return map[code];
    return String(code).replace(/_/g, ' ').replace(/\w\S*/g, function (w) { return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase(); });
  }
  function adminKitLabel(vol) {
    if (!vol) return '';
    const map = { HOME: 'Home', AWAY: 'Away', THIRD: 'Third', TRAINING: 'Training', SPECIAL: 'Special' };
    if (map[vol]) return map[vol];
    return String(vol).charAt(0).toUpperCase() + String(vol).slice(1).toLowerCase();
  }
  %>
  <div class="products-container">
    <header class="admin-jersey-topnav">
      <div class="admin-jersey-topnav__inner">
        <nav class="navigation-menu admin-jersey-navigation" aria-label="Admin">
          <ul class="nav admin-jersey-navlist justify-content-center">
            <li class="nav-item cursor-pointer">
              <a class="nav-link" href="/admin">Home</a>
            </li>
            <li class="nav-item cursor-pointer">
              <a class="nav-link active" href="/admin/product/all">Jerseys</a>
            </li>
            <li class="nav-item cursor-pointer">
              <a class="nav-link" href="/admin/user/all">Users</a>
            </li>
            <li class="nav-item cursor-pointer">
              <a class="nav-link js-admin-logout" href="/admin/logout">Logout</a>
            </li>
          </ul>
        </nav>
        <div class="admin-home-clock">
          <div class="live-clock" id="adminTopnavClock">--:--:--</div>
          <div class="clock-label">Current time</div>
        </div>
      </div>
    </header>

    <div class="products-frame">
      <div class="board">
        <div class="admin-hero products-admin-hero">
          <div class="admin-hero-left">
            <div class="admin-hero-icon" aria-hidden="true">
              <i class="fas fa-tshirt"></i>
            </div>
            <div>
              <h1>Jersey management</h1>
              <p>Manage football jersey collection and inventory</p>
            </div>
          </div>
          <div class="admin-hero-actions">
            <a href="/admin/user/all" class="admin-hero-btn-secondary">View users</a>
            <a href="#admin-add-jersey" class="admin-hero-btn-primary">+ Add jersey</a>
          </div>
        </div>

        <div class="jerseys-stats-grid">
          <div class="stat-card stat-card--total">
            <span class="stat-card-pill">Inventory</span>
            <div class="stat-icon">
              <i class="fas fa-tshirt"></i>
            </div>
            <div class="stat-content">
              <span class="stat-label">Total Jerseys</span>
              <span class="stat-number" id="totalJerseys">0</span>
            </div>
          </div>
          <div class="stat-card stat-card--active">
            <span class="stat-card-pill">Listed</span>
            <div class="stat-icon">
              <i class="fas fa-play-circle"></i>
            </div>
            <div class="stat-content">
              <span class="stat-label">Active Jerseys</span>
              <span class="stat-number" id="activeJerseys">0</span>
            </div>
          </div>
          <div class="stat-card stat-card--value">
            <span class="stat-card-pill">Revenue</span>
            <div class="stat-icon">
              <i class="fas fa-dollar-sign"></i>
            </div>
            <div class="stat-content">
              <span class="stat-label">Total Value</span>
              <span class="stat-number stat-number--currency" id="totalValue">$0</span>
            </div>
          </div>
        </div>

        <!-- Enhanced Products Table -->
        <div class="products-table-container">
          <div class="table-header">
            <h3 class="table-title">
              <i class="fas fa-list"></i>
              Football Jersey Collection
            </h3>
            <div class="table-controls">
              <div class="search-box">
                <input type="text" id="productSearch" placeholder="Search jerseys..." aria-label="Search jerseys">
              </div>
              <div class="filter-dropdown">
                <select id="leagueFilter" class="filter-select">
                  <option value="">All Leagues</option>
                  <option value="PREMIER_LEAGUE">Premier League</option>
                  <option value="LA_LIGA">La Liga</option>
                  <option value="SERIE_A">Serie A</option>
                  <option value="BUNDESLIGA">Bundesliga</option>
                  <option value="LIGUE_1">Ligue 1</option>
                  <option value="CHAMPIONS_LEAGUE">Champions League</option>
                  <option value="UZBEKISTAN_LEAGUE">Uzbekistan League</option>
                  <option value="NATIONAL_TEAMS">National Teams</option>
                  <option value="RETRO">Retro</option>
                </select>
              </div>
              <div class="filter-dropdown">
                <select id="statusFilter" class="filter-select">
                  <option value="">All Status</option>
                  <option value="PROCESS">Active</option>
                  <option value="PAUSE">Paused</option>
                  <option value="DELETE">Deleted</option>
                </select>
              </div>
            </div>
          </div>

          <div class="table-wrapper table-wrapper--jerseys">
            <table class="modern-table modern-table--jerseys">
              <thead>
                <tr>
                  <th class="sortable" data-sort="index">#</th>
                  <th class="sortable" data-sort="name">Name</th>
                  <th class="sortable" data-sort="league">League</th>
                  <th class="sortable" data-sort="kit">Kit</th>
                  <th class="sortable" data-sort="size">Size</th>
                  <th class="sortable" data-sort="price">Price</th>
                  <th class="sortable" data-sort="stock">Stock</th>
                  <th class="sortable th-col-center" data-sort="status">Status</th>
                  <th class="actions-column th-col-center">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% products.map(function(value, key){
                  var sc = typeof value.productLeftCount === 'number' ? value.productLeftCount : parseInt(value.productLeftCount, 10) || 0;
                  var subParts = [];
                  if (value.teamName) subParts.push(value.teamName);
                  if (value.uniformSeason) subParts.push(value.uniformSeason);
                  else if (value.season) subParts.push(value.season);
                  else if (value.madeYear) subParts.push(String(value.madeYear) + '–' + (parseInt(value.madeYear, 10) + 1));
                  var subline = subParts.join(' · ');
                  if (!subline && value.productDesc) subline = String(value.productDesc).slice(0, 100);
                %>
                <tr
                  class="product-row"
                  data-product-id="<%= value._id%>"
                  data-made-year="<%= value.madeYear || '' %>"
                  data-product-collection="<%= value.productCollection %>"
                  data-product-volume="<%= value.productVolume %>"
                  data-product-stock="<%= sc %>"
                >
                  <td class="product-number">
                    <span class="product-index"><%= key + 1 %></span>
                  </td>
                  <td class="product-info">
                    <div class="product-image product-image--table">
                      <% if(value.productImages && value.productImages.length > 0) { %>
                        <img src="<%= value.productImages[0] %>" alt="" class="jersey-img jersey-img--table">
                      <% } else { %>
                        <div class="image-placeholder image-placeholder--table" aria-hidden="true"></div>
                      <% } %>
                    </div>
                    <div class="product-details">
                      <span class="product-name product-name--table"><%= value.productName %></span>
                      <% if (subline) { %>
                      <span class="product-subtitle"><%= subline %></span>
                      <% } %>
                      <span class="product-desc" hidden><%= value.productDesc != null ? value.productDesc : 'No description' %></span>
                    </div>
                  </td>
                  <td class="league-cell league-cell--plain">
                    <span class="league-text"><%= adminLeagueLabel(value.productCollection) %></span>
                  </td>
                  <td class="kit-cell kit-cell--plain">
                    <span class="kit-text"><%= adminKitLabel(value.productVolume) %></span>
                  </td>
                  <td class="size-cell">
                    <span class="size-badge size-badge--neutral"><%= value.productSize %></span>
                  </td>
                  <td class="price-cell">
                    <span class="price-value">$<%= value.productPrice %></span>
                  </td>
                  <td class="stock-cell" data-product-stock="<%= sc %>">
                    <span class="stock-value-wrap">
                      <span class="stock-value <%= sc === 0 ? 'stock-value--out' : (sc >= 1 && sc <= 4 ? 'stock-value--low' : 'stock-value--ok') %>"><%= sc %></span>
                      <% if (sc === 0) { %><span class="stock-flag stock-flag--out">Out</span><% } %>
                      <% if (sc >= 1 && sc <= 4) { %><span class="stock-flag stock-flag--low">Low</span><% } %>
                    </span>
                  </td>
                  <td class="status-cell">
                    <select class="status-select status-select--table new-product-status" id="<%= value._id %>">
                      <option value="PAUSE" <%= value.productStatus === 'PAUSE' ? 'selected': '' %>>Paused</option>
                      <option value="PROCESS" <%= value.productStatus === 'PROCESS' ? 'selected': '' %>>Active</option>
                      <option value="DELETE" <%= value.productStatus === 'DELETE' ? 'selected': '' %>>Deleted</option>
                    </select>
                  </td>
                  <td class="actions-cell">
                    <div class="action-buttons">
                      <button class="action-btn view-btn" onclick="viewProduct('<%= value._id%>')" title="View Details">
                        <i class="fas fa-eye"></i>
                      </button>
                      <button class="action-btn edit-btn" onclick="editProduct('<%= value._id%>')" title="Edit Product">
                        <i class="fas fa-edit"></i>
                      </button>
                      <button class="action-btn delete-btn" onclick="deleteProduct('<%= value._id%>')" title="Delete Product">
                        <i class="fas fa-trash"></i>
                      </button>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Enhanced Add Product Form -->
        <div class="add-product-section" id="admin-add-jersey">
          <div class="section-header">
            <h3 class="section-title">Add New Jersey</h3>
            <button type="button" class="toggle-form-btn" id="toggle-form-btn">
              New Product
            </button>
          </div>

          <form
            onsubmit="return validateForm()"
            action="/admin/product/create"
            method="POST"
            class="product-form display-none"
            enctype="multipart/form-data"
            id="product-form"
          >
            <div class="form-grid">
              <div class="form-group">
                <label class="form-label">
                  Product Name
                </label>
                <input
                  type="text"
                  placeholder="Enter jersey name"
                  name="productName"
                  class="form-input"
                  required
                />
              </div>

              <input
                name="productStatus"
                value="PAUSE"
                class="product-status"
                hidden
              />
              <input name="productVolume" type="hidden" value="HOME" />

              <div class="form-group">
                <label class="form-label">
                  Price ($)
                </label>
                <input
                  type="number"
                  placeholder="Enter price"
                  name="productPrice"
                  class="form-input"
                  min="0"
                  step="0.01"
                  required
                />
              </div>

              <div class="form-group">
                <label class="form-label">
                  Stock Quantity
                </label>
                <input
                  type="number"
                  placeholder="Enter stock count"
                  name="productLeftCount"
                  class="form-input"
                  min="0"
                  required
                />
              </div>

              <div class="form-group">
                <label class="form-label">
                  League/Collection
                </label>
                <select class="form-select" name="productCollection" required>
                  <option value="PREMIER_LEAGUE">Premier League</option>
                  <option value="LA_LIGA">La Liga</option>
                  <option value="SERIE_A">Serie A</option>
                  <option value="BUNDESLIGA">Bundesliga</option>
                  <option value="LIGUE_1">Ligue 1</option>
                  <option value="CHAMPIONS_LEAGUE">Champions League</option>
                  <option value="UZBEKISTAN_LEAGUE">Uzbekistan League</option>
                  <option value="NATIONAL_TEAMS">National Teams</option>
                  <option value="RETRO">Retro</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label">
                  Size
                </label>
                <select class="form-select" name="productSize" required>
                  <option value="XS">XS</option>
                  <option value="S">S</option>
                  <option value="M" selected>M</option>
                  <option value="L">L</option>
                  <option value="XL">XL</option>
                  <option value="XXL">XXL</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">
                Jersey Made Year
              </label>
              <input
                type="number"
                name="madeYear"
                class="form-input"
                min="1900"
                max="2040"
                placeholder="e.g. 2025"
              />
              <small class="form-hint">
                Jerseys from 2025–2026 appear in New Drops automatically
              </small>
            </div>

            <div class="form-group full-width">
              <label class="form-label">
                Description
              </label>
              <textarea 
                name="productDesc" 
                class="form-textarea"
                placeholder="Enter product description..."
                rows="3"
              ></textarea>
            </div>

            <div class="form-group full-width">
              <label class="form-label">
                Product Images
              </label>
              <div class="image-upload-grid">
                <div class="upload-box">
                  <img src="/img/upload.svg" class="upload-placeholder" id="image-preview-1" />
                  <input
                    type="file"
                    name="productImages"
                    class="image-input"
                    accept="image/*"
                    onchange="previewFileHandler(this,1)"
                  />
                  <div class="upload-overlay">
                    <span>Upload image</span>
                  </div>
                </div>
                <div class="upload-box">
                  <img src="/img/upload.svg" class="upload-placeholder" id="image-preview-2" />
                  <input
                    type="file"
                    name="productImages"
                    class="image-input"
                    accept="image/*"
                    onchange="previewFileHandler(this,2)"
                  />
                  <div class="upload-overlay">
                    <span>Upload image</span>
                  </div>
                </div>
                <div class="upload-box">
                  <img src="/img/upload.svg" class="upload-placeholder" id="image-preview-3" />
                  <input
                    type="file"
                    name="productImages"
                    class="image-input"
                    accept="image/*"
                    onchange="previewFileHandler(this,3)"
                  />
                  <div class="upload-overlay">
                    <span>Upload image</span>
                  </div>
                </div>
                <div class="upload-box">
                  <img src="/img/upload.svg" class="upload-placeholder" id="image-preview-4" />
                  <input
                    type="file"
                    name="productImages"
                    class="image-input"
                    accept="image/*"
                    onchange="previewFileHandler(this,4)"
                  />
                  <div class="upload-overlay">
                    <span>Upload image</span>
                  </div>
                </div>
                <div class="upload-box">
                  <img src="/img/upload.svg" class="upload-placeholder" id="image-preview-5" />
                  <input
                    type="file"
                    name="productImages"
                    class="image-input"
                    accept="image/*"
                    onchange="previewFileHandler(this,5)"
                  />
                  <div class="upload-overlay">
                    <span>Upload image</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="form-actions">
              <button type="button" class="btn btn-secondary" id="cancel-form-btn">
                Cancel
              </button>
              <button type="submit" class="btn btn-primary">
                Create Jersey
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Product Modal -->
  <div id="editProductModal" class="modal modal-hidden edit-product-modal">
    <div class="edit-product-modal__card" role="dialog" aria-modal="true" aria-labelledby="editProductModalTitle">
      <header class="edit-product-modal__header">
        <h2 id="editProductModalTitle" class="edit-product-modal__heading">Edit Product</h2>
        <button
          type="button"
          class="edit-product-modal__close"
          onclick="closeEditModal()"
          aria-label="Close"
        >
          &times;
        </button>
      </header>
      <form id="editProductForm" class="edit-form">
        <input type="hidden" id="editProductVolume" value="" />

        <div class="edit-product-modal__body">
          <div class="edit-product-modal__grid">
            <div class="edit-product-modal__field edit-product-modal__field--full">
              <label class="edit-product-modal__label" for="editProductName">Product Name</label>
              <input
                type="text"
                id="editProductName"
                class="form-input edit-product-modal__control"
                required
              />
            </div>

            <div class="edit-product-modal__field">
              <label class="edit-product-modal__label" for="editProductPrice">Price ($)</label>
              <input
                type="number"
                id="editProductPrice"
                class="form-input edit-product-modal__control"
                min="0"
                step="0.01"
                required
              />
            </div>

            <div class="edit-product-modal__field">
              <label class="edit-product-modal__label" for="editProductSize">Size</label>
              <select id="editProductSize" class="form-input edit-product-modal__control" required>
                <option value="S">Small (S)</option>
                <option value="M">Medium (M)</option>
                <option value="L">Large (L)</option>
                <option value="XL">Extra Large (XL)</option>
                <option value="XXL">2X Large (XXL)</option>
              </select>
            </div>

            <div class="edit-product-modal__field">
              <label class="edit-product-modal__label" for="editProductCollection">League</label>
              <select id="editProductCollection" class="form-input edit-product-modal__control" required>
                <option value="PREMIER_LEAGUE">Premier League</option>
                <option value="LA_LIGA">La Liga</option>
                <option value="SERIE_A">Serie A</option>
                <option value="BUNDESLIGA">Bundesliga</option>
                <option value="LIGUE_1">Ligue 1</option>
                <option value="NATIONAL_TEAMS">National Teams</option>
                <option value="UZBEKISTAN_LEAGUE">Uzbekistan League</option>
              </select>
            </div>

            <div class="edit-product-modal__field">
              <label class="edit-product-modal__label" for="editProductLeftCount">Stock Count</label>
              <input
                type="number"
                id="editProductLeftCount"
                class="form-input edit-product-modal__control"
                min="0"
                required
              />
            </div>

            <div class="edit-product-modal__field edit-product-modal__field--full">
              <label class="edit-product-modal__label" for="editProductStatus">Status</label>
              <select id="editProductStatus" class="form-input edit-product-modal__control" required>
                <option value="PROCESS">Active</option>
                <option value="PAUSE">Inactive</option>
              </select>
            </div>

            <div class="edit-product-modal__field edit-product-modal__field--full">
              <label class="edit-product-modal__label" for="editProductDesc">Description</label>
              <textarea
                id="editProductDesc"
                class="form-input edit-product-modal__control edit-product-modal__textarea"
                rows="3"
                placeholder="Product description..."
              ></textarea>
            </div>

            <div class="edit-product-modal__field edit-product-modal__field--full">
              <label class="edit-product-modal__label" for="editMadeYear">Jersey Made Year</label>
              <input
                type="number"
                id="editMadeYear"
                class="form-input edit-product-modal__control"
                min="1900"
                max="2040"
                placeholder="e.g. 2025"
              />
              <p class="edit-product-modal__hint">
                Jerseys from 2025–2026 appear in New Drops automatically
              </p>
            </div>
          </div>
        </div>

        <footer class="edit-product-modal__footer">
          <button type="button" class="edit-product-modal__btn edit-product-modal__btn--cancel" onclick="closeEditModal()">
            Cancel
          </button>
          <button type="submit" class="edit-product-modal__btn edit-product-modal__btn--submit">
            Update Product
          </button>
        </footer>
      </form>
    </div>
  </div>

  <script type="text/javascript" src="/js/admin-topnav-clock.js"></script>
  <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer')%>
