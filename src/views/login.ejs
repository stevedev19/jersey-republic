<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>

<body>
  <div class="login-container">
    <!-- Enhanced Header Section -->
    <div class="page-header">
      <div class="header-content">
        <div class="header-icon">
          <i class="fas fa-sign-in-alt"></i>
        </div>
        <div class="header-text">
          <h1 class="page-title">Welcome Back</h1>
          <p class="page-subtitle">Sign in to Jersey Republic Management System</p>
        </div>
      </div>
      <div class="back-link">
        <a href="/admin" class="back-btn">
          <i class="fas fa-arrow-left"></i>
          Back to Home
        </a>
      </div>
    </div>

    <form class="login-form" action="/admin/login" METHOD="POST" onsubmit="return validateLoginForm()">
      <div class="login-frame">
        <!-- Navigation Links -->
        <div class="login-top">
          <div class="nav-links">
            <span class="nav-text">Don't have an account?</span>
            <a href="/admin/signup" class="nav-link">
              <i class="fas fa-user-plus"></i>
              Create Account
            </a>
          </div>
        </div>

        <!-- Form Section -->
        <div class="form-section">
          <h3 class="section-title">
            <i class="fas fa-lock"></i>
            Login Credentials
          </h3>
          
          <div class="login-input-frame">
            <div class="login-input-container">
              <label class="form-label">
                <i class="fas fa-store"></i>
                Restaurant Name *
              </label>
              <input
                type="text"
                name="memberNick"
                class="member-nick form-input"
                placeholder="Enter your restaurant name"
                value=""
                required
              />
            </div>
            
            <div class="login-input-container">
              <label class="form-label">
                <i class="fas fa-key"></i>
                Password *
              </label>
              <div class="password-container">
                <input
                  type="password"
                  name="memberPassword"
                  class="member-password form-input"
                  placeholder="Enter your password"
                  value=""
                  required
                  id="passwordInput"
                />
                <button type="button" class="password-toggle" id="passwordToggle">
                  <i class="fas fa-eye"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Remember Me & Forgot Password -->
          <div class="login-options">
            <div class="remember-me">
              <input type="checkbox" id="rememberMe" name="rememberMe">
              <label for="rememberMe" class="checkbox-label">
                <i class="fas fa-check"></i>
                Remember me
              </label>
            </div>
            <a href="#" class="forgot-password" onclick="showForgotPassword()">
              <i class="fas fa-question-circle"></i>
              Forgot Password?
            </a>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="submit-section">
          <button class="login-btn btn" name="login" type="submit">
            <i class="fas fa-sign-in-alt"></i>
            Sign In
          </button>
          
          <div class="security-notice">
            <i class="fas fa-shield-alt"></i>
            <span>Your login is secured with industry-standard encryption</span>
          </div>
        </div>

      </div>
    </form>
  </div>

  <script type="text/javascript" src="/js/login.js"></script>
</body>

<%- include('includes/footer') %>
