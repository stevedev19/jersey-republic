<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />

<body>
  <div class="login-page">
    <a href="/admin" class="login-page__back">Back</a>

    <div class="login-page__main">
      <form class="login-form" action="/admin/login" METHOD="POST" onsubmit="return validateLoginForm()">
        <div class="login-card">
          <p class="login-card__eyebrow">Jersey Republic</p>
          <h1 class="login-card__title">Sign in to your account</h1>

          <div class="login-card__fields">
            <div class="login-field">
              <label class="login-field__label" for="login-username">Username</label>
              <input
                id="login-username"
                type="text"
                name="memberNick"
                class="member-nick form-input"
                placeholder="Enter your username"
                value=""
                required
                autocomplete="username"
              />
            </div>

            <div class="login-field">
              <label class="login-field__label" for="passwordInput">Password</label>
              <div class="login-field__password-wrap">
                <input
                  type="password"
                  name="memberPassword"
                  class="member-password form-input"
                  placeholder="Enter your password"
                  value=""
                  required
                  id="passwordInput"
                  autocomplete="current-password"
                />
                <button type="button" class="password-toggle" id="passwordToggle" aria-label="Show password">
                  <span class="password-toggle__text">Show</span>
                </button>
              </div>
            </div>
          </div>

          <div class="login-card__row">
            <div class="remember-me">
              <input type="checkbox" id="rememberMe" name="rememberMe" />
              <label for="rememberMe" class="remember-me__label">Remember me</label>
            </div>
            <a href="#" class="login-card__link" onclick="showForgotPassword(); return false;">Forgot password?</a>
          </div>

          <button class="login-submit-btn" name="login" type="submit">Sign in</button>
        </div>
      </form>

      <p class="login-page__footer">
        Don&apos;t have an account?
        <a href="/admin/signup" class="login-page__footer-link">Sign up</a>
      </p>
    </div>
  </div>

  <script type="text/javascript" src="/js/login.js"></script>
</body>

<%- include('includes/footer') %>
